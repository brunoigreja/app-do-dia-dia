{
  "expo": {
    "name": "Diário do dia",
    "slug": "app-do-dia-dia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/capa1.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#002973",
        "foregroundImage": "./assets/capa1.png",
        "backgroundImage": "./assets/capa1.png",
        "monochromeImage": "./assets/capa1.png"
      }
    },
    "web": {
      "favicon": "./assets/capa1.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/capa1.png",
          "color": "#002973",
          "androidMode": "default",
          "androidCollapsedTitle": "Diário do dia",
          "iosDisplayInForeground": true
        }
      ],
      "expo-status-bar"
    ]
  }
}
